meta {
  name: Login (seeded admin)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "admin@local.test",
    "password": "Admin123!"
  }
}

script:post-response {
  if (res.body && res.body.token) {
    bru.setEnvVar("authToken", res.body.token);
  }
}
